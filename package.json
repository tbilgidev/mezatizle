{
  "name": "mezatizle",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter @mezatizle/api --filter @mezatizle/web dev",
    "dev:api": "bun run --filter @mezatizle/api dev",
    "dev:web": "bun run --filter @mezatizle/web dev",
    "build:web": "bun run --filter @mezatizle/web build",
    "serve:web": "bun run scripts/serve-web.ts",
    "migrate": "bun run --filter @mezatizle/db migrate",
    "test": "bun test",
    "test:api": "bun test apps/api packages/db packages/shared",
    "typecheck": "bun run --filter '*' typecheck",
    "worker": "cd workers/extractor && ../../.venv/bin/python3 worker.py",
    "start:live": "bash scripts/start-live.sh",
    "synth:fixture": "./.venv/bin/python3 scripts/make-synthetic-live.py",
    "smoke": "bun run scripts/smoke-pipeline.ts",
    "purge:media": "bun run scripts/purge-media-retention.ts",
    "purge:media:dry": "bun run scripts/purge-media-retention.ts --dry-run"
  },

  "dependencies": {
    "@mezatizle/db": "workspace:*",
    "@mezatizle/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  }
}
