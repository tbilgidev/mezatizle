# mezatizle local defaults — copy to .env (never commit secrets)
NODE_ENV=development
PROCESSING_PROFILE=LOCAL
# Unit tests only — never set these in live/start scripts:
# FORCE_MOCK_ASR=1
# FORCE_MOCK_OCR=1
HARD_SPEND_LIMIT_USD=0
EMBEDDED_WORKER=1

# API
API_HOST=0.0.0.0
API_PORT=43127
CORS_ORIGIN=*

# PostgreSQL
DATABASE_URL=postgres://mezatizle:mezatizle@127.0.0.1:5433/mezatizle

# Local filesystem storage (relative to repo root)
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=524288000

# FFmpeg / OCR sampling (1–2 fps recommended)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FRAME_INTERVAL_SECONDS=1
OCR_FPS=1
OCR_ENGINE=tesseract
OCR_CROP_FRAC=0.45,0.35,0.98,0.95
OCR_MAX_FRAMES=900
AUDIO_CODEC=pcm_s16le
AUDIO_SAMPLE_RATE=16000

# faster-whisper CPU (base|small); int8 keeps RAM lower
WHISPER_MODEL=base
WHISPER_COMPUTE=int8
WHISPER_BEAM=1
PYTHON_BIN=./.venv/bin/python3

# Worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_ID=local-extractor-1

# Live capture (yt-dlp + ffmpeg; operator session optional)
YT_DLP_PATH=yt-dlp
LIVE_PROBE_INTERVAL_MS=20000
LIVE_MAX_WAIT_MS=21600000
MAX_LIVE_BYTES=2147483648
LIVE_CAPTURE_SUPERVISOR=1
LIVE_MAX_HEIGHT=720
LIVE_FPS=30
LIVE_CRF=26
LIVE_MAXRATE_K=2500
LIVE_AUDIO_K=96

# Auto-capture lives from accounts the watcher IG follows (nihan.dogansoy)
# Set AUTO_FOLLOW_LIVE=0 to disable the background poller entirely.
AUTO_FOLLOW_LIVE=1
# Poll interval 5–6 min (300000–360000 ms, default 330000 / 5.5 min) with jitter.
# On HTTP 429 backs off to ≥12 min. Scan pauses while any recording is active.
AUTO_FOLLOW_LIVE_POLL_MS=330000

# Optional paid backends (disabled unless profile=API and keys set)
# OPENAI_API_KEY=
# VISION_API_KEY=

# Web (Vite)
VITE_API_BASE=
