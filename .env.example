# mezatizle local defaults — copy to .env (never commit secrets)
NODE_ENV=development
PROCESSING_PROFILE=LOCAL
FORCE_MOCK_ASR=1
FORCE_MOCK_OCR=1
HARD_SPEND_LIMIT_USD=0
EMBEDDED_WORKER=1

# API
API_HOST=0.0.0.0
API_PORT=43127
CORS_ORIGIN=*

# PostgreSQL
DATABASE_URL=postgres://mezatizle:mezatizle@127.0.0.1:5432/mezatizle

# Local filesystem storage (relative to repo root)
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=524288000

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FRAME_INTERVAL_SECONDS=5
AUDIO_CODEC=pcm_s16le
AUDIO_SAMPLE_RATE=16000

# Worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_ID=local-extractor-1

# Live capture (yt-dlp + ffmpeg; operator session optional)
YT_DLP_PATH=yt-dlp
LIVE_PROBE_INTERVAL_MS=20000
LIVE_MAX_WAIT_MS=21600000
MAX_LIVE_BYTES=2147483648
LIVE_CAPTURE_SUPERVISOR=1
# Compact quality defaults (analyzable ASR/OCR)
LIVE_MAX_HEIGHT=720
LIVE_FPS=20
LIVE_CRF=28
LIVE_MAXRATE_K=1800
LIVE_AUDIO_K=80
# LIVE_YTDLP_FORMAT=best[height<=720]/best

# Optional paid backends (disabled unless profile=API and keys set)
# OPENAI_API_KEY=
# VISION_API_KEY=
# WHISPER_MODEL=tiny

# Web (Vite)
VITE_API_BASE=
# Leave empty to use Vite same-origin /api proxy (recommended for tunnels)
# VITE_API_BASE=http://127.0.0.1:43127
